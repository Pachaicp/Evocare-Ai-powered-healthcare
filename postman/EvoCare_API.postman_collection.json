{
	"info": {
		"_postman_id": "evocare-api-2024",
		"name": "EvoCare API Collection",
		"description": "Complete REST API collection for EvoCare – AI-Powered Elderly Healthcare Management Platform.\n\nBase URL: http://localhost:8080/api\n\nAuthentication: JWT Bearer Token\nSet {{token}} variable after login.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080/api" },
		{ "key": "token", "value": "" }
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "{{baseUrl}}/auth/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test Doctor\",\n  \"email\": \"testdoctor@evocare.com\",\n  \"password\": \"Test@123\",\n  \"role\": \"ROLE_DOCTOR\"\n}"
						}
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.success) {",
									"  pm.collectionVariables.set('token', res.data.accessToken);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "{{baseUrl}}/auth/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@evocare.com\",\n  \"password\": \"Admin@123\"\n}"
						}
					}
				},
				{
					"name": "Login as Doctor",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.success) pm.collectionVariables.set('token', res.data.accessToken);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "{{baseUrl}}/auth/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"doctor@evocare.com\",\n  \"password\": \"Doctor@123\"\n}"
						}
					}
				},
				{
					"name": "Login as Caregiver",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "{{baseUrl}}/auth/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"caregiver@evocare.com\",\n  \"password\": \"Care@123\"\n}"
						}
					}
				},
				{
					"name": "Login as Patient",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "{{baseUrl}}/auth/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"patient@evocare.com\",\n  \"password\": \"Patient@123\"\n}"
						}
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/refresh?token=YOUR_REFRESH_TOKEN"
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/auth/logout"
					}
				}
			]
		},
		{
			"name": "Users (Admin)",
			"item": [
				{
					"name": "Get All Users",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/users?page=0&size=10"
					}
				},
				{
					"name": "Get User by ID",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/users/1"
					}
				},
				{
					"name": "Toggle User Status",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/users/2/toggle-status"
					}
				},
				{
					"name": "Update User Role",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/users/2/role?role=ROLE_DOCTOR"
					}
				},
				{
					"name": "Dashboard Stats",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/users/dashboard-stats"
					}
				}
			]
		},
		{
			"name": "Patients",
			"item": [
				{
					"name": "Get All Patients",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/patients?page=0&size=10"
					}
				},
				{
					"name": "Get Patient by ID",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/patients/1"
					}
				},
				{
					"name": "Get Patient by Code",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/patients/code/PAT-DEMO001"
					}
				},
				{
					"name": "Search Patients",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/patients/search?q=arjun"
					}
				},
				{
					"name": "Create Patient",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/patients",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Raju Kumar\",\n  \"age\": 75,\n  \"gender\": \"Male\",\n  \"bloodGroup\": \"B+\",\n  \"address\": \"123 Park Lane, Mumbai\",\n  \"emergencyContact\": \"+91-9988776655\",\n  \"medicalHistory\": \"Hypertension, Type 2 Diabetes\"\n}"
						}
					}
				},
				{
					"name": "Update Patient",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/patients/1",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"medicalHistory\": \"Hypertension, Diabetes, Updated 2024\"\n}"
						}
					}
				},
				{
					"name": "Assign Staff to Patient",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/patients/1/assign",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"doctorId\": 2,\n  \"caregiverId\": 3\n}"
						}
					}
				},
				{
					"name": "Get Patients by Doctor",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/patients/by-doctor/2"
					}
				},
				{
					"name": "Get Patients by Caregiver",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/patients/by-caregiver/3"
					}
				}
			]
		},
		{
			"name": "Observations",
			"item": [
				{
					"name": "Add Observation",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/observations",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patientId\": 1,\n  \"symptom\": \"High fever\",\n  \"severity\": \"HIGH\",\n  \"notes\": \"Temperature reading: 103°F. Patient is restless.\"\n}"
						}
					}
				},
				{
					"name": "Get Observations by Patient",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/observations/patient/1?page=0&size=10"
					}
				},
				{
					"name": "Get Recent Observations",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/observations/recent"
					}
				}
			]
		},
