						],
						"url": "{{baseUrl}}/medications",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patientId\": 1,\n  \"medicineName\": \"Lisinopril\",\n  \"dosage\": \"10mg\",\n  \"frequency\": \"Once daily\",\n  \"startDate\": \"2024-01-01\",\n  \"instructions\": \"Take in the morning with water\"\n}"
						}
					}
				},
				{
					"name": "Get Medications by Patient",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/medications/patient/1"
					}
				},
				{
					"name": "Delete Medication",
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/medications/1"
					}
				}
			]
		},
		{
			"name": "Medical Reports",
			"item": [
				{
					"name": "Upload Report",
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/reports/upload",
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "patientId", "value": "1" },
								{ "key": "file", "type": "file" },
								{ "key": "reportType", "value": "Blood Test" },
								{ "key": "description", "value": "HbA1c and CBC panel" }
							]
						}
					}
				},
				{
					"name": "Get Reports by Patient",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/reports/patient/1"
					}
				}
			]
		},
		{
			"name": "Clinical Notes",
			"item": [
				{
					"name": "Add Clinical Note",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/clinical-notes",
						"body": {
							"mode": "raw",
